# =============================================================================
# Chatwoot self-hosted — reference .env tuned for MAX performance / MIN cost
# =============================================================================
# Baseline target: a small/cheap VPS with 2 vCPU / 4 GB RAM (the cost sweet spot).
# Copy to `.env`, fill the secrets, and scale the *_CONCURRENCY values with your box.
# Every value here is a real, code-backed key (see docs/self-hosting/cost-and-performance.md).
# -----------------------------------------------------------------------------

# --- Core (required) ---------------------------------------------------------
RAILS_ENV=production
SECRET_KEY_BASE=replace_with_rake_secret          # generate: bundle exec rake secret
FRONTEND_URL=https://chat.yourdomain.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false                       # close public signups = less abuse/compute

# Active Record Encryption (required for MFA + encrypted IMAP/SMTP passwords)
# generate: bundle exec rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Ruby runtime: free performance, lower RAM -------------------------------
RUBY_YJIT_ENABLE=1                                 # YJIT on Ruby 3.4 = ~15-30% faster, no extra cost
MALLOC_ARENA_MAX=2                                 # cuts glibc memory fragmentation = lower RAM bill

# --- Web (Puma): concurrency = WEB_CONCURRENCY x RAILS_MAX_THREADS -----------
# Rule of thumb: WEB_CONCURRENCY = number of vCPUs. 5 threads is the MRI sweet spot.
WEB_CONCURRENCY=2                                  # 2 vCPU -> 2 workers
RAILS_MAX_THREADS=5                                # also sets the web DB pool size
# RAILS_MIN_THREADS=5                              # defaults to RAILS_MAX_THREADS

# --- Background jobs (Sidekiq) ----------------------------------------------
SIDEKIQ_CONCURRENCY=10                             # also sets the worker DB pool; drop to 5 on a 2 GB box
ENABLE_SIDEKIQ_DEQUEUE_LOGGER=false                # keep logs lean

# --- PostgreSQL (needs the `pgvector` extension for Captain embeddings) ------
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_me
# POSTGRES_DATABASE=chatwoot_production
POSTGRES_STATEMENT_TIMEOUT=14s                     # kills runaway queries before they hog CPU
DB_POOL_REAPING_FREQUENCY=30
# max_connections must cover: (WEB_CONCURRENCY x RAILS_MAX_THREADS) + SIDEKIQ_CONCURRENCY + headroom.
# Above baseline needs ~25; Postgres default (100) is fine. Past ~4 workers, front it with PgBouncer.

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_me
REDIS_ALFRED_SIZE=5                                # online-presence pool; raise only under heavy load
REDIS_VELMA_SIZE=10                                # reporting pool

# --- Storage: local disk = zero object-storage bill (small installs) ---------
ACTIVE_STORAGE_SERVICE=local
# At scale, switch to S3/R2 for durability + offloaded bandwidth:
# ACTIVE_STORAGE_SERVICE=s3
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# ASSET_CDN_HOST=                                  # front assets with a free CDN (e.g. Cloudflare)

# --- Logging: smaller volume = cheaper storage/egress ------------------------
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info                                     # use `warn` to shrink log volume further
LOG_SIZE=500

# --- Abuse protection: throttling = no wasted compute or AI spend ------------
ENABLE_RACK_ATTACK=true
RACK_ATTACK_LIMIT=300
ENABLE_RACK_ATTACK_WIDGET_API=true

# --- Housekeeping: keep tables lean = faster queries, smaller DB -------------
REMOVE_STALE_CONTACT_INBOX_JOB_STATUS=true

# --- Email (outbound) --------------------------------------------------------
MAILER_SENDER_EMAIL=Support <support@yourdomain.com>
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# =============================================================================
# AI / Captain  (Enterprise edition; pay OpenAI per token directly — no Cloud credits)
# NOTE: Captain keys below are NOT read from ENV. Set them in:
#   Super Admin -> Settings -> Configuration  (InstallationConfig)
# Listed here only as a checklist of cost-optimal values.
# -----------------------------------------------------------------------------
# CAPTAIN_OPEN_AI_API_KEY   = <your OpenAI key>
# CAPTAIN_OPEN_AI_MODEL     = gpt-4.1-mini        # cheapest capable default; gpt-4.1-nano = max savings
# CAPTAIN_EMBEDDING_MODEL   = text-embedding-3-small   # cheapest viable embedding
# CAPTAIN_OPEN_AI_ENDPOINT  = (leave default)     # set only for Azure/OpenRouter/local proxy
# CAPTAIN_FIRECRAWL_API_KEY = (leave empty)        # empty = free in-house crawler, no paid API

# OSS AI features (reply suggestions / summarize / label suggestion) DO use ENV:
# OPENAI_API_KEY=
# =============================================================================
