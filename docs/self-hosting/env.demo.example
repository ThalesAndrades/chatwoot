# =============================================================================
# Chatwoot DEMO .env — for a Hostinger VPS deploy via docker-compose.production.yaml
# Goal: a self-contained demo with an admin login and sample data showing every feature.
# Copy to `.env` next to docker-compose.production.yaml, then fill the secrets.
# =============================================================================

# --- Core ---------------------------------------------------------------------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
SECRET_KEY_BASE=replace_with_rake_secret          # docker compose run --rm rails bundle exec rake secret
FRONTEND_URL=https://chat.yourdomain.com          # the public URL of your VPS (with the domain/SSL)
FORCE_SSL=true                                     # true when a reverse proxy terminates TLS in front
ENABLE_ACCOUNT_SIGNUP=false                        # demo: keep public sign-ups closed

# Active Record Encryption (required for MFA + encrypted IMAP/SMTP passwords)
# generate: docker compose run --rm rails bundle exec rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Demo admin + sample data (read by `rails demo:setup`) --------------------
DEMO_ACCOUNT_NAME=Demo Company
DEMO_ADMIN_NAME=Admin
DEMO_ADMIN_EMAIL=thales@thmtecnologia.com           # admin login email
DEMO_ADMIN_PASSWORD=@Telemed123                     # min 6 chars, 1 upper, 1 number, 1 symbol
ENABLE_ACCOUNT_SEEDING=true                         # allows the rich sample-data seeder in production

# --- PostgreSQL (the pgvector/pgvector:pg16 service in the compose file) -------
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot                          # MUST match POSTGRES_DB in the compose file
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_me                         # MUST also be set on the postgres service (see guide)
POSTGRES_STATEMENT_TIMEOUT=14s

# --- Redis (the redis:alpine service in the compose file) ---------------------
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_me

# --- Storage & logging --------------------------------------------------------
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# --- Performance (free wins; see cost-and-performance.md) ----------------------
RUBY_YJIT_ENABLE=1
MALLOC_ARENA_MAX=2
WEB_CONCURRENCY=2                                    # = vCPUs of your VPS
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=10                               # drop to 5 on a 2 GB box
ENABLE_RACK_ATTACK=true
RACK_ATTACK_LIMIT=300

# --- Outbound email (optional for a demo; needed for password resets/invites) -
MAILER_SENDER_EMAIL="Demo Support <support@yourdomain.com>"
SMTP_DOMAIN=yourdomain.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# =============================================================================
# AI / Captain is Enterprise-only and needs your own OpenAI key — out of scope
# for this OSS demo. Set CAPTAIN_* in Super Admin -> Settings -> Configuration
# only if you run the Enterprise build. See cost-and-performance.md.
# =============================================================================
